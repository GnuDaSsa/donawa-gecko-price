{
  "name": "donawa-price-finder",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "collect": "node --env-file=.env.local --env-file=.env.collectors scripts/collect.mjs",
    "collect:feedle": "node --env-file=.env.local --env-file=.env.collectors scripts/collect.mjs --source=feedle",
    "collect:shops": "node --env-file=.env.local --env-file=.env.collectors scripts/collect.mjs --source=shops",
    "pasamo:login": "node scripts/pasamo-review.mjs --mode=login",
    "pasamo:review": "node --env-file-if-exists=.env.local --env-file-if-exists=.env.collectors scripts/pasamo-review.mjs --mode=review",
    "scheduler:configure": "node --env-file=.env.local --env-file=.env.collectors scripts/configure-scheduler.mjs",
    "sources:discover": "node --env-file=.env.local --env-file=.env.collectors scripts/source-discovery.mjs --mode=discover",
    "sources:candidates": "node --env-file=.env.local --env-file=.env.collectors scripts/source-discovery.mjs --mode=list",
    "sources:discover:gpt": "node --env-file=.env.local --env-file=.env.collectors scripts/source-discovery.mjs --mode=openai",
    "sources:prices:gpt": "node --env-file=.env.local --env-file=.env.collectors scripts/source-discovery.mjs --mode=price-candidates",
    "import:listings": "node --env-file=.env.local --env-file=.env.collectors scripts/import-listings.mjs",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.2",
    "lucide-react": "^1.30.0",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-kakao-maps-sdk": "^1.2.1"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.19.11",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "playwright": "^1.62.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10",
    "wrangler": "^4.121.0"
  }
}
